.codegpt

# Quarto build output (regenerated on every build)
_site/
.quarto/
**/site_libs/
# ...except inside _freeze, which Quarto needs to rebuild without R
!**/_freeze/site_libs/
*_files/
*.html
!_extensions/**/*.html
!_freeze/**/*.html
content/book/*.html
content/playground/*.html
content/slides/*.html

# Copied in by copy_resources.ts before each build
content/playground/*.csv
downloads/*
!downloads/From-Data-to-Thesis.pdf
!downloads/FROM-DATA-TO-THESIS.pdf

/.quarto/
**/*.quarto_ipynb

# Stray plot files from running R scripts outside an interactive session
Rplots.pdf

# Temporary Office files
~$*

# Python & Packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
build/
dist/

