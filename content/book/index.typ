#Skylighting(([#NormalTok("inv_wb ");#OperatorTok("=");#NormalTok(" semester2.query(");#StringTok("\"workshop == 'Invited'\"");#NormalTok(")[");#StringTok("\"wellbeing\"");#NormalTok("].dropna()");],
