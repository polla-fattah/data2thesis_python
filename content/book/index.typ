[#NormalTok("caffeine_mg            25");],
[#NormalTok("supervisor_meetings     0");],
[#NormalTok("wellbeing               0");],
[#NormalTok("dtype: int64");],
[],
[#NormalTok("Missing values in students (per column):");],
[#NormalTok("student_id               0");],
