#figure([
#box(image("08-anova-regression_files/figure-typst/fig-violations-output-1.svg", alt: "Three residual plots. The first shows an even horizontal band of points around zero. The second shows points forming a U shape. The third shows points fanning out from narrow on the left to wide on the right."))
], caption: figure.caption(
