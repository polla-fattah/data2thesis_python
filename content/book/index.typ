#Skylighting(([#FunctionTok("fviz_cluster");#NormalTok("(clusters, ");#AttributeTok("data =");#NormalTok(" profile_data, ");#AttributeTok("geom =");#NormalTok(" ");#StringTok("\"point\"");#NormalTok(", ");#AttributeTok("ellipse.type =");#NormalTok(" ");#StringTok("\"convex\"");#NormalTok(",");],
