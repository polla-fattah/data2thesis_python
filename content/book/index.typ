[#NormalTok("        mean_absolute_error(tiny[");#StringTok("'actual'");#NormalTok("], tiny[");#StringTok("'predicted'");#NormalTok("]),");],
[#NormalTok("        r2_score(tiny[");#StringTok("'actual'");#NormalTok("], tiny[");#StringTok("'predicted'");#NormalTok("])");],
[#NormalTok("    ]");],
[#NormalTok("})");],));
#table(
  columns: 3,
  align: (auto,auto,auto,),
  table.header(table.cell(align: right)[], table.cell(align: right)[.metric], table.cell(align: right)[.estimate],),
