[#NormalTok("  t_mixed    ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("coef");#NormalTok("(");#FunctionTok("summary");#NormalTok("(mixed))[");#StringTok("\"trained\"");#NormalTok(", ");#StringTok("\"t value\"");#NormalTok("]");],
