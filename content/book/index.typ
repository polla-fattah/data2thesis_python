[],
[#NormalTok("geyser ");#OperatorTok("=");#NormalTok(" GaussianMixture(n_components");#OperatorTok("=");#DecValTok("2");#NormalTok(", covariance_type");#OperatorTok("=");#StringTok("'full'");#NormalTok(", random_state");#OperatorTok("=");#DecValTok("123");#NormalTok(").fit(waiting)");],
