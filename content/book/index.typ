[#NormalTok("    .dropna()");],
[#NormalTok(")");],
[],
[#NormalTok("scaler ");#OperatorTok("=");#NormalTok(" StandardScaler()");],
[#NormalTok("profile_features ");#OperatorTok("=");#NormalTok(" profiles.drop(columns");#OperatorTok("=");#NormalTok("[");#StringTok("\"student_id\"");#NormalTok("])");],
