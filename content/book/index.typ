== Measuring prediction error
<measuring-prediction-error>
The quality of a numeric prediction is judged by its errors. Five students whose final GPA a model has predicted show how:

#Skylighting(([#NormalTok("tiny ");#OperatorTok("=");#NormalTok(" pd.DataFrame({");],
[#NormalTok("    ");#StringTok("'actual'");#NormalTok(":    [");#FloatTok("3.2");#NormalTok(", ");#FloatTok("2.8");#NormalTok(", ");#FloatTok("3.6");#NormalTok(", ");#FloatTok("3.0");#NormalTok(", ");#FloatTok("2.5");#NormalTok("],");],
[#NormalTok("    ");#StringTok("'predicted'");#NormalTok(": [");#FloatTok("3.0");#NormalTok(", ");#FloatTok("2.9");#NormalTok(", ");#FloatTok("3.3");#NormalTok(", ");#FloatTok("3.1");#NormalTok(", ");#FloatTok("2.9");#NormalTok("]");],
[#NormalTok("})");],
[#NormalTok("tiny[");#StringTok("'error'");#NormalTok("] ");#OperatorTok("=");#NormalTok(" tiny[");#StringTok("'actual'");#NormalTok("] ");#OperatorTok("-");#NormalTok(" tiny[");#StringTok("'predicted'");#NormalTok("]");],
[#NormalTok("tiny");],));
#table(
  columns: 4,
  align: (auto,auto,auto,auto,),
  table.header(table.cell(align: right)[], table.cell(align: right)[actual], table.cell(align: right)[predicted], table.cell(align: right)[error],),
