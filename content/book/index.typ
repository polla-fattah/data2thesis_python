#figure([
#box(image("12-classification_files/figure-typst/fig-tree-output-1.svg", alt: "A tree diagram. The top split is on support. Further splits on stress and other scale scores lead to leaves labelled Yes or No, each with the number of Yes and No students in it."))
], caption: figure.caption(
position: bottom, 
[
A decision tree of depth 3 for considering dropout. At each split, students who meet the condition go left.
