[#NormalTok("==================================================================================================");],
[#NormalTok("                                     coef    std err          z      P>|z|      [0.025      0.975]");],
[#NormalTok("--------------------------------------------------------------------------------------------------");],
[#NormalTok("Intercept                         -4.0186      1.232     -3.263      0.001      -6.433      -1.604");],
[#NormalTok("C(employment)[T.None]             -0.5893      0.438     -1.346      0.178      -1.448       0.269");],
[#NormalTok("C(employment)[T.Part-time job]    -0.5387      0.452     -1.191      0.234      -1.425       0.348");],
[#NormalTok("C(study_mode)[T.Part-time]         0.2764      0.367      0.752      0.452      -0.444       0.996");],
[#NormalTok("stress                             1.2823      0.240      5.346      0.000       0.812       1.752");],
[#NormalTok("support                           -1.1102      0.204     -5.444      0.000      -1.510      -0.710");],
[#NormalTok("financial_worry                    0.4537      0.122      3.731      0.000       0.215       0.692");],
[#NormalTok("==================================================================================================");],));
