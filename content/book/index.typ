[#NormalTok("}) ");#SpecialCharTok("|>");],
[#NormalTok("  ");#FunctionTok("list_rbind");#NormalTok("() ");#SpecialCharTok("|>");],
[#NormalTok("  ");#FunctionTok("mutate");#NormalTok("(");#AttributeTok("total_cost =");#NormalTok(" cost_miss ");#SpecialCharTok("*");#NormalTok(" misses ");#SpecialCharTok("+");#NormalTok(" cost_false_alarm ");#SpecialCharTok("*");#NormalTok(" false_alarms)");],
[],
[#NormalTok("best_cost ");#OtherTok("<-");#NormalTok(" cost_curve ");#SpecialCharTok("|>");#NormalTok(" ");#FunctionTok("slice_min");#NormalTok("(total_cost, ");#AttributeTok("n =");#NormalTok(" ");#DecValTok("1");#NormalTok(", ");#AttributeTok("with_ties =");#NormalTok(" ");#ConstantTok("FALSE");#NormalTok(")");],
