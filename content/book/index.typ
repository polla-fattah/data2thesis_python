[#NormalTok("  ");#FunctionTok("labs");#NormalTok("(");#AttributeTok("x =");#NormalTok(" ");#StringTok("\"Group\"");#NormalTok(", ");#AttributeTok("y =");#NormalTok(" ");#StringTok("\"Stress score\"");#NormalTok(") ");#SpecialCharTok("+");],
[#NormalTok("  ");#FunctionTok("theme_minimal");#NormalTok("(");#AttributeTok("base_size =");#NormalTok(" ");#DecValTok("12");#NormalTok(")");],));
#figure([
#box(image("08-anova-regression_files/figure-typst/fig-partition-1.svg", alt: "Twelve points in three columns, A, B, and C. Each column has a short horizontal line at its average; group B's line is highest. A dashed horizontal line marks the overall average across the whole plot."))
], caption: figure.caption(
position: bottom, 
[
Variation between and within groups. Points are individual scores, short black lines are group averages, and the dashed line is the overall average. The gaps between the black lines and the dashed line are between-group variation; the spread of the points around their black line is within-group variation.
]), 
kind: "quarto-float-fig", 
supplement: "Figure", 
