[#NormalTok("}");],
[],
[#FunctionTok("set.seed");#NormalTok("(");#DecValTok("12");#NormalTok(")");],
[#NormalTok("false_alarms ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("replicate");#NormalTok("(");#DecValTok("500");#NormalTok(", ");#FunctionTok("simulate_clustered");#NormalTok("())");],
[#FunctionTok("rowMeans");#NormalTok("(false_alarms)");],));
#block[
#Skylighting(([#NormalTok("ordinary    mixed ");],
[#NormalTok("   0.268    0.074 ");],));
