[#NormalTok("  wellbeing  ");#OtherTok("<-");#NormalTok(" ");#DecValTok("60");#NormalTok(" ");#SpecialCharTok("+");#NormalTok(" style ");#SpecialCharTok("+");#NormalTok(" ");#FunctionTok("rnorm");#NormalTok("(");#DecValTok("200");#NormalTok(", ");#AttributeTok("sd =");#NormalTok(" ");#DecValTok("10");#NormalTok(")");],
