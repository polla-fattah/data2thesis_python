[],
[#NormalTok("welch_test ");#OperatorTok("=");#NormalTok(" stats.ttest_ind(inv_wb, ctrl_wb, equal_var");#OperatorTok("=");#VariableTok("False");#NormalTok(")");],
[#NormalTok("ci_diff ");#OperatorTok("=");#NormalTok(" welch_test.confidence_interval(confidence_level");#OperatorTok("=");#FloatTok("0.95");#NormalTok(")");],
[],
[#BuiltInTok("print");#NormalTok("(");#SpecialStringTok("f\"Welch t:    ");#SpecialCharTok("{");#NormalTok("welch_test");#SpecialCharTok(".");#NormalTok("statistic");#SpecialCharTok(":.2f}");#SpecialStringTok("\"");#NormalTok(")");],
[#BuiltInTok("print");#NormalTok("(");#SpecialStringTok("f\"df:         ");#SpecialCharTok("{");#NormalTok("welch_test");#SpecialCharTok(".");#NormalTok("df");#SpecialCharTok(":.1f}");#SpecialStringTok("\"");#NormalTok(")");],
[#BuiltInTok("print");#NormalTok("(");#SpecialStringTok("f\"p-value:    ");#SpecialCharTok("{");#NormalTok("welch_test");#SpecialCharTok(".");#NormalTok("pvalue");#SpecialCharTok(":.2e}");#SpecialStringTok("\"");#NormalTok(")");],
[#BuiltInTok("print");#NormalTok("(");#SpecialStringTok("f\"95% CI diff:[");#SpecialCharTok("{");#NormalTok("ci_diff");#SpecialCharTok(".");#NormalTok("low");#SpecialCharTok(":.2f}");#SpecialStringTok(", ");#SpecialCharTok("{");#NormalTok("ci_diff");#SpecialCharTok(".");#NormalTok("high");#SpecialCharTok(":.2f}");#SpecialStringTok("]\"");#NormalTok(")");],));
#block[
