[#NormalTok("    (");#StringTok("'prep'");#NormalTok(", gpa_recipe),");],
[#NormalTok("    (");#StringTok("'model'");#NormalTok(", Lasso(alpha");#OperatorTok("=");#FloatTok("0.03");#NormalTok(", random_state");#OperatorTok("=");#DecValTok("2026");#NormalTok("))");],
[#NormalTok("])");],
[#NormalTok("lasso_small.fit(X_small, y_small)");],
[],
[#NormalTok("lasso_small_rmse ");#OperatorTok("=");#NormalTok(" root_mean_squared_error(y_test, lasso_small.predict(X_test))");],
[#BuiltInTok("print");#NormalTok("(");#SpecialStringTok("f\"Lasso Test Set RMSE (60 students): ");#SpecialCharTok("{");#NormalTok("lasso_small_rmse");#SpecialCharTok(":.3f}");#SpecialStringTok("\"");#NormalTok(")");],));
#block[
#Skylighting(([#NormalTok("Lasso Test Set RMSE (60 students): 0.221");],));
]
]
From the same 60 students, the lasso's RMSE on new students is #NormalTok("0.221");, against #NormalTok("0.664"); for ordinary regression. The penalty kept the model from chasing noise.

