)
#ref(<fig-conditional-means>, supplement: [Figure]) places these averages over the individual students, together with a straight regression line.

#Skylighting(([#NormalTok("fig, ax ");#OperatorTok("=");#NormalTok(" plt.subplots(figsize");#OperatorTok("=");#NormalTok("(");#FloatTok("6.5");#NormalTok(", ");#DecValTok("4");#NormalTok("))");],
[#NormalTok("ax.scatter(study[");#StringTok("\"sleep_hours\"");#NormalTok("], study[");#StringTok("\"gpa\"");#NormalTok("], alpha");#OperatorTok("=");#FloatTok("0.2");#NormalTok(", color");#OperatorTok("=");#StringTok("\"#666666\"");#NormalTok(", label");#OperatorTok("=");#StringTok("\"Students\"");#NormalTok(")");],
