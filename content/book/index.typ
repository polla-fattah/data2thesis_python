[#NormalTok("    (");#StringTok("'model'");#NormalTok(", LogisticRegression(class_weight");#OperatorTok("=");#StringTok("'balanced'");#NormalTok(", random_state");#OperatorTok("=");#DecValTok("2026");#NormalTok("))");],
[#NormalTok("])");],
[],
[#NormalTok("balanced_cv ");#OperatorTok("=");#NormalTok(" cross_validate(");],
[#NormalTok("    balanced_pipe, X_train, y_train, cv");#OperatorTok("=");#NormalTok("dropout_folds,");],
[#NormalTok("    scoring");#OperatorTok("=");#NormalTok("[");#StringTok("'roc_auc'");#NormalTok(", ");#StringTok("'recall'");#NormalTok(", ");#StringTok("'precision'");#NormalTok("]");],
[#NormalTok(")");],
[],
[#NormalTok("pd.DataFrame({");],
[#NormalTok("    ");#StringTok("'.metric'");#NormalTok(": [");#StringTok("'roc_auc'");#NormalTok(", ");#StringTok("'sensitivity'");#NormalTok(", ");#StringTok("'precision'");#NormalTok("],");],
