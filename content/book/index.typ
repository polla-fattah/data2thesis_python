[#NormalTok("        sd_y");#OperatorTok("=");#NormalTok("(");#StringTok("\"y\"");#NormalTok(", ");#StringTok("\"std\"");#NormalTok(")");],
[#NormalTok("    )");],
[#NormalTok("    .");#BuiltInTok("round");#NormalTok("(");#DecValTok("2");#NormalTok(")");],
