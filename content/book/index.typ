#box(image("11-machine-learning_files/figure-typst/fig-bias-variance-1.svg", alt: "Two lines against polynomial degree. The training error line falls steadily towards zero. The new-data error line falls to a minimum at a low degree and then rises steeply for the most flexible models."))
