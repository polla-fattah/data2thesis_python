[#NormalTok("shares ");#OperatorTok("=");#NormalTok(" dropout_data[");#StringTok("\"considering_dropout\"");#NormalTok("].value_counts(normalize");#OperatorTok("=");#VariableTok("True");#NormalTok(")");],
