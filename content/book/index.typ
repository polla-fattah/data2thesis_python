#Skylighting(([#NormalTok("lasso_small ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("workflow");#NormalTok("(gpa_recipe,");],
[#NormalTok("                        ");#FunctionTok("linear_reg");#NormalTok("(");#AttributeTok("penalty =");#NormalTok(" ");#FloatTok("0.03");#NormalTok(", ");#AttributeTok("mixture =");#NormalTok(" ");#DecValTok("1");#NormalTok(") ");#SpecialCharTok("|>");#NormalTok(" ");#FunctionTok("set_engine");#NormalTok("(");#StringTok("\"glmnet\"");#NormalTok(")) ");#SpecialCharTok("|>");],
[#NormalTok("  ");#FunctionTok("fit");#NormalTok("(");#AttributeTok("data =");#NormalTok(" small_train)");],
[],
[#FunctionTok("augment");#NormalTok("(lasso_small, ");#AttributeTok("new_data =");#NormalTok(" gpa_test) ");#SpecialCharTok("|>");#NormalTok(" ");#FunctionTok("regression_metrics");#NormalTok("(final_gpa, .pred)");],));
#block[
#Skylighting(([#NormalTok("# A tibble: 3 × 3");],
[#NormalTok("  .metric .estimator .estimate");],
[#NormalTok("  <chr>   <chr>          <dbl>");],
[#NormalTok("1 rmse    standard       0.204");],
[#NormalTok("2 mae     standard       0.168");],
[#NormalTok("3 rsq     standard       0.616");],));
]
]
From the same 60 students, the lasso's RMSE on new students is 0.20, against 0.53 for ordinary regression. The penalty kept the model from chasing noise.

