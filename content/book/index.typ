[#NormalTok("q[");#StringTok("\"stress_4\"");#NormalTok("] ");#OperatorTok("=");#NormalTok(" ");#DecValTok("6");#NormalTok(" ");#OperatorTok("-");#NormalTok(" q[");#StringTok("\"stress_4\"");#NormalTok("]  ");#CommentTok("# reverse item 4");],
[],
[#NormalTok("alphas ");#OperatorTok("=");#NormalTok(" {");],
[#NormalTok("    ");#StringTok("\"Stress\"");#NormalTok(": cronbach_alpha(q.");#BuiltInTok("filter");#NormalTok("(like");#OperatorTok("=");#StringTok("\"stress_\"");#NormalTok(")),");],
