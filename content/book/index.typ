<fig-tuning>


#block[
#Skylighting(([#NormalTok("best_depth ");#OperatorTok("=");#NormalTok(" grid_search.best_params_[");#StringTok("\"classifier__max_depth\"");#NormalTok("]");],
[#BuiltInTok("print");#NormalTok("(");#StringTok("\"Best max_depth:\"");#NormalTok(", best_depth)");],
[#BuiltInTok("print");#NormalTok("(");#SpecialStringTok("f\"Best CV ROC AUC: ");#SpecialCharTok("{");#NormalTok("grid_search");#SpecialCharTok(".");#NormalTok("best_score_");#SpecialCharTok(":.3f}");#SpecialStringTok("\"");#NormalTok(")");],));
