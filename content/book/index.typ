#block[
#Skylighting(([#NormalTok("chick_model ");#OtherTok("<-");#NormalTok(" ");#FunctionTok("lmer");#NormalTok("(weight ");#SpecialCharTok("~");#NormalTok(" Time ");#SpecialCharTok("*");#NormalTok(" Diet ");#SpecialCharTok("+");#NormalTok(" (Time ");#SpecialCharTok("|");#NormalTok(" Chick), ");#AttributeTok("data =");#NormalTok(" ChickWeight)");],
