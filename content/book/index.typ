[#NormalTok("       Yes  13  22");],
[#NormalTok("       No   10 106");],));
]
#Skylighting(([#NormalTok("test_results ");#SpecialCharTok("|>");#NormalTok(" ");#FunctionTok("class_metrics");#NormalTok("(");#AttributeTok("truth =");#NormalTok(" considering_dropout, ");#AttributeTok("estimate =");#NormalTok(" flag)");],));
#block[
#Skylighting(([#NormalTok("# A tibble: 5 × 3");],
[#NormalTok("  .metric     .estimator .estimate");],
