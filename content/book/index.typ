#Skylighting(([#ImportTok("from");#NormalTok(" statsmodels.tsa.seasonal ");#ImportTok("import");#NormalTok(" STL");],
[],
[#NormalTok("stl ");#OperatorTok("=");#NormalTok(" STL(visits[");#StringTok("'visits'");#NormalTok("], period");#OperatorTok("=");#DecValTok("52");#NormalTok(", robust");#OperatorTok("=");#VariableTok("True");#NormalTok(")");],
[#NormalTok("visits_stl ");#OperatorTok("=");#NormalTok(" stl.fit()");],));
