[#NormalTok("  ");#FunctionTok("geom_line");#NormalTok("(");#AttributeTok("linewidth =");#NormalTok(" ");#DecValTok("1");#NormalTok(", ");#AttributeTok("colour =");#NormalTok(" ");#StringTok("\"#2f6793\"");#NormalTok(") ");#SpecialCharTok("+");],
