== Data for prediction
<data-for-prediction>
A predictive model can only use information that would be available when the prediction is made. The university wants to act at the end of the first semester, so the model may use the students' background, their questionnaire scores from the start of the year, and their first-semester records, but nothing from later. The questionnaire scores are calculated as before:

#block[
#Skylighting(([#NormalTok("scores ");#OperatorTok("=");#NormalTok(" pd.DataFrame({");],
[#NormalTok("    ");#StringTok("\"student_id\"");#NormalTok(": questionnaire[");#StringTok("\"student_id\"");#NormalTok("],");],
[#NormalTok("    ");#StringTok("\"stress\"");#NormalTok(": questionnaire[[");#StringTok("\"stress_1\"");#NormalTok(", ");#StringTok("\"stress_2\"");#NormalTok(", ");#StringTok("\"stress_3\"");#NormalTok(", ");#StringTok("\"stress_5\"");#NormalTok(", ");#StringTok("\"stress_6\"");#NormalTok("]].assign(stress_4");#OperatorTok("=");#DecValTok("6");#NormalTok(" ");#OperatorTok("-");#NormalTok(" questionnaire[");#StringTok("\"stress_4\"");#NormalTok("]).mean(axis");#OperatorTok("=");#DecValTok("1");#NormalTok("),");],
[#NormalTok("    ");#StringTok("\"burnout\"");#NormalTok(": questionnaire.");#BuiltInTok("filter");#NormalTok("(like");#OperatorTok("=");#StringTok("\"burnout_\"");#NormalTok(").mean(axis");#OperatorTok("=");#DecValTok("1");#NormalTok("),");],
[#NormalTok("    ");#StringTok("\"support\"");#NormalTok(": questionnaire.");#BuiltInTok("filter");#NormalTok("(like");#OperatorTok("=");#StringTok("\"support_\"");#NormalTok(").mean(axis");#OperatorTok("=");#DecValTok("1");#NormalTok("),");],
[#NormalTok("    ");#StringTok("\"satisfaction\"");#NormalTok(": questionnaire.");#BuiltInTok("filter");#NormalTok("(like");#OperatorTok("=");#StringTok("\"satisfaction_\"");#NormalTok(").mean(axis");#OperatorTok("=");#DecValTok("1");#NormalTok("),");],
[#NormalTok("})");],
[],
[#NormalTok("sem1 ");#OperatorTok("=");#NormalTok(" semesters[semesters[");#StringTok("\"semester\"");#NormalTok("] ");#OperatorTok("==");#NormalTok(" ");#DecValTok("1");#NormalTok("].drop(columns");#OperatorTok("=");#NormalTok("[");#StringTok("\"semester\"");#NormalTok("])");],
[],
[#NormalTok("dropout_data ");#OperatorTok("=");#NormalTok(" (");],
[#NormalTok("    students");],
[#NormalTok("    .merge(scores, on");#OperatorTok("=");#StringTok("\"student_id\"");#NormalTok(")");],
[#NormalTok("    .merge(sem1, on");#OperatorTok("=");#StringTok("\"student_id\"");#NormalTok(")");],
[#NormalTok("    .drop(columns");#OperatorTok("=");#NormalTok("[");#StringTok("\"student_id\"");#NormalTok(", ");#StringTok("\"supervisor_id\"");#NormalTok(", ");#StringTok("\"workshop\"");#NormalTok(", ");#StringTok("\"workshop_sessions\"");#NormalTok("])");],
[#NormalTok(")");],
